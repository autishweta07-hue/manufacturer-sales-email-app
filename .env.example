# Internal application access (optional). Set both to require HTTP Basic auth on the app UI and admin APIs.
APP_USER=
APP_PASS=

# Secret used to sign per-recipient tracking, CTA and unsubscribe links.
TRACKING_SECRET=replace-with-a-long-random-string

# Shared secret expected in the x-webhook-secret header on provider webhooks.
WEBHOOK_SECRET=replace-with-another-long-random-string

# Public base URL recipients can reach (needed for tracking/CTA/unsubscribe links).
PUBLIC_APP_URL=http://localhost:3000

# Master kill switch. Sending stays disabled until this is explicitly set to true.
ALLOW_SENDING=false

# SMTP delivery using an authorised company mailbox / provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Company Name <sales@company.example>"
EMAIL_REPLY_TO=

# Open tracking is opt-in and must be disclosed to recipients.
OPEN_TRACKING_ENABLED=false

# Where imported files, campaign data and the sales deck are stored. Keep outside the public folder.
DATA_DIR=./data
